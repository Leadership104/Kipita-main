<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/group_info_header"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@color/white"
        android:minHeight="49dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backarrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_baseline_arrow_back_ios_new_24"
            app:tint="@color/black"
            tools:ignore="ContentDescription"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_toRightOf="@+id/backarrow"
            android:background="@color/white"
            android:gravity="center|left"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grp_name_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="Add Services"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/imageViewDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/ic_select_sevice_done"
            app:tint="@color/black"
            tools:ignore="ContentDescription"/>
    </RelativeLayout>

    <View
        android:id="@+id/lineView"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/yellow_bottom"/>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center"
        android:background="@color/black"
        android:gravity="center|left"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLabelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:text="Choose service to show on advisory section"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_create_link"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:background="@drawable/allotbuttongreen"
        android:text="Create Own Link"
        android:textColor="@color/white" />

    <FrameLayout
        android:id="@+id/frameLayout_register"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:padding="@dimen/_5sdp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerFramlayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_repeat_mode="restart">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/swipeToRefresh_parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">




            <LinearLayout
                android:id="@+id/animation_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:layout_margin="@dimen/_10sdp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNoData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:gravity="center"
                    android:text="No Data Found"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_16sdp" />

                <ImageView
                    android:layout_width="@dimen/_170sdp"
                    android:layout_height="@dimen/_170sdp"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/no_data_onee" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgNoData"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:gravity="center"
                    android:text="If no data found at this location than change the location. And try again"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_reg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_15sdp" />

        </LinearLayout>

    </FrameLayout>


</LinearLayout>