<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearLayoutSubMenu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:background="@color/black"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/backarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:src="@drawable/ic_backarrow_sub_menu"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_toRightOf="@id/llBack"
                android:layout_weight="5.8"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titelSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:gravity="center|left"
                    android:text="Back"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_19sdp" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <RelativeLayout
            android:id="@+id/animation_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/sf_pro_display_bold"
                android:gravity="center"
                android:text="No Data Found"
                android:textColor="@color/fade_black"
                android:textSize="@dimen/_16sdp" />

            <ImageView
                android:id="@+id/imgNoData"
                android:layout_width="@dimen/_170sdp"
                android:layout_height="@dimen/_170sdp"
                android:layout_below="@+id/txtNoData"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:src="@drawable/no_data_twoe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgNoData"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/sf_pro_display_bold"
                android:gravity="center"
                android:text="If no data found at this location than change the location. And try again"
                android:textColor="@color/fade_black"
                android:textSize="@dimen/_12sdp" />

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/frameLayout_register"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="10dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerFramlayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_repeat_mode="restart">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                    <include layout="@layout/shimmer_layout1"></include>

                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeToRefresh_reg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView_reg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </FrameLayout>
    </LinearLayout>
</LinearLayout>