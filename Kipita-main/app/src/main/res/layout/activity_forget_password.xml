<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    tools:context=".ForgetPasswordActivity">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">


        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_keyboard_arrow_left_black_24dp" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <ImageView
            android:layout_width="@dimen/_200sdp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_weight="3"
            android:background="@drawable/logo"
            android:padding="1.0dip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="3.5"
            android:gravity="center"
            android:orientation="vertical">



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_toRightOf="@+id/backbtn"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="Forgot "
                android:textColor="@color/black"
                android:textSize="@dimen/_22sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_toRightOf="@+id/backbtn"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="Password ?"
                android:textColor="@color/black"
                android:textSize="@dimen/_22sdp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_20sdp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="top|center|left"
                android:layout_marginRight="@dimen/_20sdp"
                android:text="Don't worry! It happens. Please enter the emailid or mobile number associated with your account."
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_11sdp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_weight="3.5"
            android:orientation="vertical"
            android:weightSum="15">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top|center"
                android:gravity="top|center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:orientation="vertical"
                    android:weightSum="2">



                    <EditText
                        android:id="@+id/ufname"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:cursorVisible="true"
                        android:drawableLeft="@drawable/ic_mail_black_24dp"
                        android:drawablePadding="10dp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:hint="Enter MailId / Mobile No."
                        android:inputType="textCapWords"
                        android:paddingLeft="10dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/textColorBlack"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>


                <Button
                    android:id="@+id/login"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_39sdp"
                    android:background="@drawable/allotbuttonblue"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:minWidth="@dimen/_200sdp"
                    android:minHeight="@dimen/_45sdp"
                    android:paddingLeft="@dimen/_20sdp"
                    android:paddingRight="@dimen/_20sdp"
                    android:text="Reset Password"
                    android:textSize="@dimen/_15sdp"
                    android:textColor="@color/white" />


            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

