<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp">


    <FrameLayout
        android:id="@+id/frameLayout_register"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerFramlayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_repeat_mode="restart">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

                <include layout="@layout/shimmer_layout1"></include>

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>


        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeToRefresh_reg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/animation_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_margin="@dimen/_10sdp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNoData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/sf_pro_display_bold"
                        android:gravity="center"
                        android:layout_centerHorizontal="true"
                        android:text="No Data Found"
                        android:textColor="@color/fade_black"
                        android:textSize="@dimen/_16sdp" />

                    <ImageView
                        android:layout_width="@dimen/_170sdp"
                        android:layout_height="@dimen/_170sdp"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:scaleType="fitXY"
                        android:src="@drawable/no_data_threee" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/sf_pro_display_bold"
                        android:gravity="center"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@+id/imgNoData"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="If no data found at this location than change the location. And try again"
                        android:textColor="@color/fade_black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/recyclerView_reg"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="@dimen/card_margin"
                    android:background="@color/blue"
                    android:backgroundTint="@color/white"
                    android:foregroundTint="@color/white"
                    android:src="@drawable/ic_baseline_add_a_photo_24"
                    app:rippleColor="@color/blue" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_reg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </RelativeLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>


</LinearLayout>