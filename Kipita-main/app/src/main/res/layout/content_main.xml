    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="75dp"
        android:visibility="gone"
        android:src="@drawable/baseline_people_outline_24"
        tools:ignore="ContentDescription" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="75dp"
        android:src="@drawable/baseline_burst_mode_24"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/red_bottom"
        android:orientation="horizontal"
        android:paddingTop="@dimen/_2sdp">

        <LinearLayout
            android:id="@+id/first"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@color/red_bottom"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_placetogo"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/textFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_medium"
                android:text="Places"
                android:textColor="@color/white"
                android:textSize="@dimen/_9sdp"
                tools:text="Places" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/second"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_advisory"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/textSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_medium"
                android:text="Advisory"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_9sdp"
                tools:text="Advisory" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/third"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconThird"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_planner"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/textThird"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_medium"
                android:text="Travel"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_9sdp"
                tools:text="Planner" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/fourth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconFourth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/baseline_attractions_24"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/textFourth"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:text="Perks"
                android:textColor="@color/textColorBlack"
                android:textSize="@dimen/_9sdp"
                tools:text="Galaxy" />

        </LinearLayout>
    </LinearLayout>


    <!--    </com.google.android.material.bottomappbar.BottomAppBar>-->

