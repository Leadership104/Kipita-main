<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="@dimen/_7sdp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/group_info_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:minHeight="49dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backarrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:background="@drawable/ic_baseline_arrow_back_ios_new_24">

        </ImageView>


        <LinearLayout

            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginLeft="30dp"
            android:background="@color/blue"
            android:gravity="center|left"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grp_name_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="Image Viewer"
                android:textColor="@color/white"
                android:textSize="19sp" />


        </LinearLayout>


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lisData"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/failed_msg"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/sf_pro_display_regular"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/_8sdp" />


            <TextView
                android:id="@+id/failed_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/gray"
                android:layout_above="@+id/submitBtn"
                android:fontFamily="@font/sf_pro_display_bold"
                android:padding="@dimen/_4sdp"
                android:text="In case if you have any issue please connect to administrator (admin@my2tum.com)"
                android:layout_centerHorizontal="true"
                android:visibility="gone"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <Button
                android:id="@+id/submitBtn"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_30sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/allotbuttonblue"
                android:fontFamily="@font/sf_pro_display_bold"
                android:minWidth="@dimen/_220sdp"
                android:minHeight="@dimen/_45sdp"
                android:paddingLeft="@dimen/_20sdp"
                android:paddingRight="@dimen/_20sdp"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp" />


        </RelativeLayout>


    </androidx.cardview.widget.CardView>
</LinearLayout>
