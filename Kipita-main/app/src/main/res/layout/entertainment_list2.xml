<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_3sdp"
    android:layout_marginBottom="@dimen/_3sdp"
    android:background="@drawable/ic_place_cardview_background"
    app:cardBackgroundColor="#ffffff"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            android:padding="1dp"
            android:visibility="gone"
            android:weightSum="10">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_weight="5"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="FORMID"
                android:textColor="@color/text_color_new"
                android:textSize="@dimen/_8sdp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:gravity="center|right"
                android:orientation="horizontal"
                android:weightSum="5">

                <TextView
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:gravity="right" />

                <TextView
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:gravity="right" />


                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:gravity="right"
                    android:text="Processing"
                    android:textColor="@color/text_color_new"
                    android:textSize="@dimen/_11sdp"
                    android:visibility="invisible" />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/root_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:background="@android:color/white"
            android:orientation="horizontal"
            android:weightSum="10">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.4">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/dog_img"
                    android:layout_width="@dimen/_65sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/splash"
                    app:civ_border_color="@color/red"
                    app:civ_border_width="1.5dip" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="7.6"
                android:orientation="vertical"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingRight="@dimen/_3sdp"
                android:paddingLeft="@dimen/_2sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="10"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8.2"
                        android:fontFamily="@font/sf_pro_display_bold"
                        android:text="Patels Puff House"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13sdp" />

                    <TextView
                        android:id="@+id/openOrClosed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:textAllCaps="false"
                        android:textSize="@dimen/_9sdp"
                        tools:text="Open" />

                </LinearLayout>

                <TextView
                    android:id="@+id/category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:textColor="@color/textColorBlack"
                    android:visibility="gone"
                    android:textSize="@dimen/_11sdp"
                    tools:text="category" />

                <TextView
                    android:id="@+id/phoneNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_11sdp"
                    android:visibility="gone"
                    tools:text="phone number" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_star_24" />

                    <TextView
                        android:id="@+id/ratingDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:text="5 . 24 mins ."
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_11sdp" />
                    <TextView
                        android:id="@+id/wheelChairDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/dot_label"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textSize="@dimen/_16sdp"
                        android:textColor="@color/textColorBlack" />

                    <ImageView
                        android:id="@+id/wheelChairImage"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/wheel_chair"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/petDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/dot_label"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_16sdp"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/petImage"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/pet_icon"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/pricingDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/dot_label"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_16sdp"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/textPricing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:text="400 for two"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/distanceDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/dot_label"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_16sdp"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/textDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:text="400 for two"
                        android:textColor="@color/textColorBlack"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="6"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_11sdp"
                    tools:text="address" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_3sdp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/call_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="CALL"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/dir_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="DIRECTION"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/info_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="MORE INFO"
                    android:textColor="@color/textColorBlack"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
