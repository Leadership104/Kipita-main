<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#ffffff"
    app:cardUseCompatPadding="true"
    app:contentPadding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="5dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="1"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/linearName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_example_green"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:padding="5dp"
                    android:text="CW"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/linearName"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:text="Neeraj Binani"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSeen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last seen 0:00"
                    android:visibility="gone"
                    android:textColor="@color/textColorBlack" />

                <LinearLayout
                    android:id="@+id/linearDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textEta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 mi away"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textColor="@color/textColorBlack" />
                    <CheckBox
                        android:id="@+id/checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="rtl"
                        android:text="Delete" />

                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:weightSum="3"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_request"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginEnd="2.5dp"
                android:layout_weight="1.2"
                android:background="@drawable/background_btn_dark_red"
                android:text="Request Location"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:layout_weight="0.9"
                android:background="@drawable/background_btn_dark_red"
                android:text="Send Location"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_message"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="2.5dp"
                android:layout_weight="0.9"
                android:background="@drawable/background_btn_dark_red"
                android:text="Send Message"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
