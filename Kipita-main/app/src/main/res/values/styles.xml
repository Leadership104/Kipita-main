    <style name="chatOptionsBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/chatOptionsBottomSheetStyleWrapper</item>
    </style>

    <style name="chatOptionsBottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
    </style>
    <style name="CustomPickerBottomSheet" parent="SSImagePickerBaseBottomSheetDialog">
        <item name="ssSheetCameraViewStyle">@style/PickerBottomSheetText</item>
        <item name="ssSheetGalleryViewStyle">@style/PickerBottomSheetText</item>
        <item name="ssSheetCancelViewStyle">@style/PickerBottomSheetText</item>
    </style>
    <style name="TextAppearance.Design.Hint" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">?attr/colorControlActivated</item>
    </style>
    <style name="InputLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:paddingBottom">@dimen/input_label_vertical_spacing</item>
        <item name="android:paddingLeft">@dimen/input_label_horizontal_spacing</item>
        <item name="android:paddingRight">@dimen/input_label_horizontal_spacing</item>
    </style>
    <style name="PickerBottomSheetText" parent="SSBottomSheetTextViewStyle">
        <item name="android:textColor">@color/text_color_new</item>
        <item name="android:textSize">@dimen/_15sdp</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/color_text</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_8sdp</item>
        <item name="hintTextColor">@color/cb_blue_button</item>
    </style>
    <style name="TitleStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_10sdp</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Button</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">@dimen/_15sdp</item>
    </style>

    <style name="ButtonSelectorStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="strokeColor">@color/cb_blue_button</item>
        <item name="android:textColor">@drawable/selector_button_text_color</item>
    </style>

    <style name="CustomSSImagePicker" parent="SSImagePicker">
        <item name="ssToolbarBackIcon">@drawable/ic_arrow_back_ios</item>
        <item name="ssToolbarDoneTextAppearance">@style/CustomDoneTextAppearance</item>
        <item name="ssPickerGridCountLandscape">3</item>
        <item name="ssImageSelectIcon">@drawable/ic_baseline_check_circle</item>
    </style>

    <style name="CustomDoneTextAppearance" parent="SSToolbarDoneTextAppearance">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_15sdp</item>
    </style>



    <style name="SwitchStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_4sdp</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Button</item>
        <item name="android:textColor">@color/text_color_new</item>
        <item name="thumbTint">@drawable/selector_switch_thumb</item>
        <item name="trackTint">@drawable/selector_switch_track</item>
    </style>

    <style name="SSImagePicker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!--For Image picker activity-->
        <item name="ssStatusBarColor">@color/colorPrimary</item>
        <item name="ssStatusBarLightMode">true</item>
        <item name="ssToolbarBackground">@color/colorPrimary</item>
        <item name="ssToolbarBackIcon">@drawable/ic_ss_arrow_back</item>
        <item name="ssToolbarTextAppearance">@style/SSToolbarTitleTextAppearance</item>
        <item name="ssToolbarCameraIcon">@drawable/ic_ss_camera</item>
        <item name="ssToolbarDoneIcon">@drawable/ic_ss_done</item>
        <item name="ssToolbarDoneText">@string/str_done</item>
        <item name="ssToolbarDoneTextAppearance">@style/SSToolbarDoneTextAppearance</item>
        <item name="ssPickerBackground">@color/white</item>
        <item name="ssProgressIndicatorStyle">@style/SSProgressIndicatorStyle</item>
        <item name="ssFolderTextViewStyle">@style/SSFolderTextStyle</item>
        <item name="ssNoDataText">@string/error_no_data_found</item>
        <item name="ssNoDataTextViewStyle">@style/SSNoDataTextStyle</item>
        <item name="ssImagePickerLimitText">@string/str_picker_limit</item>
        <item name="ssPickerGridCount">2</item>
        <item name="ssPickerGridCountLandscape">4</item>
        <item name="ssImageSelectIcon">@drawable/ic_ss_check_circle</item>
        <item name="ssImageZoomIcon">@drawable/ic_ss_zoom_eye</item>
        <item name="ssUCropToolbarColor">?attr/ssToolbarBackground</item>
        <item name="ssUCropStatusBarColor">?attr/ssStatusBarColor</item>
        <item name="ssUCropToolbarWidgetColor">@color/white</item>
        <item name="ssUCropActiveControlWidgetColor">@color/colorPrimary</item>
    </style>

    <style name="SSToolbarTitleTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SSToolbarDoneTextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_15sdp</item>
    </style>

    <style name="SSFolderTextStyle">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:paddingStart">@dimen/_5sdp</item>
        <item name="android:paddingEnd">@dimen/_5sdp</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_15sdp</item>
    </style>

    <style name="SSNoDataTextStyle">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/_8sdp</item>
        <item name="android:paddingBottom">@dimen/_8sdp</item>
        <item name="android:paddingStart">@dimen/_4sdp</item>
        <item name="android:paddingEnd">@dimen/_4sdp</item>
        <item name="android:layout_marginStart">@dimen/_16sdp</item>
        <item name="android:layout_marginEnd">@dimen/_16sdp</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_10sdp</item>
    </style>

    <style name="SSProgressIndicatorStyle">
        <item name="indicatorColor">?attr/ssToolbarBackground</item>
    </style>

    <style name="SSImagePickerBaseBottomSheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="bottomSheetStyle">@style/SSRoundBottomSheet</item>
        <!--For Picker Bottom Sheet-->
        <item name="ssSheetCameraText">@string/str_camera</item>
        <item name="ssSheetGalleryText">@string/str_gallery</item>
        <item name="ssSheetCancelText">@string/str_cancel</item>
        <item name="ssSheetCameraButtonBackground">@drawable/bg_ss_picker_option_button</item>
        <item name="ssSheetGalleryButtonBackground">@drawable/bg_ss_picker_option_button</item>
        <item name="ssSheetCancelButtonBackground">@drawable/bg_ss_picker_option_button_cancel
        </item>
        <item name="ssSheetCameraViewStyle">@style/SSBottomSheetTextViewStyle</item>
        <item name="ssSheetGalleryViewStyle">@style/SSBottomSheetTextViewStyle</item>
        <item name="ssSheetCancelViewStyle">@style/SSBottomSheetTextViewStyle</item>
        <item name="ssSheetBackground">@drawable/bg_ss_picker_option</item>
    </style>

    <style name="SSRoundBottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">?attr/ssSheetBackground</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="SSBottomSheetTextViewStyle">
        <item name="android:textColor">@color/design_default_color_on_secondary</item>
        <item name="android:textSize">@dimen/_15sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/_15sdp</item>
    </style>

    <style name="PickerOptionsBottomSheetDialog" parent="@style/Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="bottomSheetStyle">@style/RoundCornerBottomSheet</item>
    </style>

    <style name="RoundCornerBottomSheet" parent="@style/Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/drawable_bottom_sheet_dialog</item>
    </style>

    <style name="popup_window_animation">
        <item name="android:windowEnterAnimation">@anim/view_hide</item>
        <item name="android:windowExitAnimation">@anim/view_show</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="pw_animation">
        <item name="android:windowEnterAnimation">@anim/view_hide</item>
        <item name="android:windowExitAnimation">@anim/view_show</item>
    </style>


    <style name="MaterialDialogSheet" parent="@android:style/Theme.Dialog">
        <item name="android:windowIsTranslucent">true</item>
<!--        <item name="android:windowBackground">@android:color/transparent</item>-->

        <item name="android:windowBackground">@color/background_color_gray_50_opacity</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/popup_window_animation</item>
    </style>

    <style name="DialogCreateLinkStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
    </style>




